# HorizonQuant Agent Environment Configuration (Template — never commit real keys)

# Deployer wallet private key (hex with 0x prefix) — requires ~3-5 HSK on Mainnet (chainId 177)
DEPLOYER_PRIVATE_KEY=

# Ephemeral AI Agent session key address authorized to sign EIP-712 TradeIntents
AGENT_ADDRESS=0x0000000000000000000000000000000000000000

# Optional RPC overrides (defaults to official HashKey Chain endpoints)
HSK_MAINNET_RPC_URL=https://mainnet.hsk.xyz
HSK_TESTNET_RPC_URL=https://testnet.hsk.xyz

# Optional API server port for local Copilot & Telemetry server
HORIZON_API_PORT=8787
